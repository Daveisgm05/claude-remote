# Copy to /etc/ccremote.env on the server and fill in.

# Long random string. The phone sends it as the X-Token header on every call.
#   openssl rand -hex 32
CCR_TOKEN=

# Bind locally; Tailscale Serve terminates TLS in front of it.
CCR_BIND_HOST=127.0.0.1
CCR_BIND_PORT=8080

# Absolute path to the claude binary (bootstrap.sh fills this in).
CCR_CLAUDE_BIN=/usr/local/bin/claude

# Where sessions and transcripts are stored.
CCR_DB=/opt/ccremote/data/runs.sqlite3
CCR_TASKS=/opt/ccremote/orchestrator/tasks.yaml

# How many Claude Code processes may run at once.
CCR_MAX_CONCURRENT=2

# Hard stop for a single turn, in seconds.
CCR_TURN_TIMEOUT=3600

# Push notifications (optional). Leave CCR_NTFY_URL empty to disable.
CCR_NTFY_URL=
CCR_NTFY_TOPIC=
CCR_NTFY_TOKEN=

# Used as the tap-through link on notifications.
CCR_PUBLIC_URL=

# The Claude Code process gets a clean environment: PATH, HOME, USER, SHELL,
# LANG, TZ, TMPDIR, TERM, SSH_AUTH_SOCK only. Name anything else you want
# passed through here, comma separated.
CCR_PASS_ENV=

# BILLING SWITCH.
# Leave both lines commented -> sessions use your Claude subscription, exactly
# like the terminal does.
# Uncomment both -> Claude Code meters against the API key instead. The key is
# only handed over when it is named in CCR_PASS_ENV, so this cannot flip by
# accident.
# ANTHROPIC_API_KEY=sk-ant-...
# CCR_PASS_ENV=ANTHROPIC_API_KEY
