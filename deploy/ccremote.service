# Reference copy. bootstrap.sh writes this to /etc/systemd/system/ccremote.service
# with the real user and paths substituted in.
[Unit]
Description=Claude Code Remote orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/opt/ccremote
EnvironmentFile=/etc/ccremote.env
ExecStart=/opt/ccremote/.venv/bin/python -m orchestrator.app
Restart=always
RestartSec=3
# No NoNewPrivileges= here: it forbids setuid for every child of the service,
# and "sudo ccr-git" from inside a session is exactly that. The sudoers file
# (/etc/sudoers.d/ccremote) is what limits what sudo can do instead.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
