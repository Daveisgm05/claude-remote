#!/usr/bin/env bash
# Clone or update ANY of the owner's GitHub repositories, on behalf of a
# sandboxed Claude Code session, without that session ever being able to read
# the credential.
#
# The session user may run this through sudo but cannot read the token file
# (root 600) or the askpass helper (root 700). The token is passed to git via
# GIT_ASKPASS, never on a command line -- /proc/<pid>/cmdline is world-readable
# on Linux, so a token in a clone URL would be visible to `ps`.
#
# Root only ever runs git in /var/lib/ccremote/mirrors, which root owns. The
# user's checkout is cloned/pulled FROM that mirror as the user. Root never
# executes git inside a user-writable repo, because .git/hooks and .git/config
# (core.fsmonitor, etc.) are code, and code in a user-owned repo run by root
# is root for the user.
set -euo pipefail

# One token per GitHub account or organisation. A fine-grained token belongs to
# exactly one resource owner, so covering several owners means several tokens:
#   /etc/ccremote-git.d/<owner>.token     e.g. alice.token, my-org.token
# /etc/ccremote-git.token is the fallback for owners with no file of their own
# (a classic token, which is account-wide, works there).
TOKEN_DIR=/etc/ccremote-git.d
TOKEN_FILE=/etc/ccremote-git.token
ASKPASS=/usr/local/libexec/ccr-askpass
APP_USER="${APP_USER:-claude}"
PROJECTS="$(getent passwd "$APP_USER" | cut -d: -f6)/projects"

die() { echo "ccr-git: $*" >&2; exit 2; }
[[ $EUID -eq 0 ]] || die "must be run through sudo"

# Owner names are case-insensitive on GitHub; token files are lowercase.
token_for() {
  local owner; owner="$(printf '%s' "${1%%/*}" | tr '[:upper:]' '[:lower:]')"
  if [[ -r "$TOKEN_DIR/$owner.token" ]]; then
    printf '%s' "$TOKEN_DIR/$owner.token"
  elif [[ -r $TOKEN_FILE ]]; then
    printf '%s' "$TOKEN_FILE"
  else
    die "no token for '$owner' -- add $TOKEN_DIR/$owner.token"
  fi
}

# owner/name only. Rejects flags, paths, URLs and anything that could turn into
# a git option (--upload-pack=... would run an arbitrary command).
valid_repo() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

# Root never runs git inside a folder the session user can write to. A
# .git/hooks/* script or a core.fsmonitor line in .git/config would otherwise
# execute as root the next time root touched that repo. So GitHub is only ever
# talked to from a root-owned bare mirror, and the user's checkout is filled
# from that mirror by the user, with no token in play.
MIRRORS=/var/lib/ccremote/mirrors
as_user() { runuser -u "$APP_USER" -- "$@"; }

sync_mirror() {   # sync_mirror owner/name folder  -> mirror up to date
  local repo="$1" name="$2" mirror="$MIRRORS/$2.git"
  install -d -m 755 -o root -g root "$MIRRORS"
  if [[ ! -d $mirror ]]; then
    CCR_TOKEN_FILE="$(token_for "$repo")" GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0 \
      git clone --quiet --mirror "https://x-access-token@github.com/$repo.git" "$mirror" \
      || die "clone failed (is $repo spelled right, and does the token cover it?)"
  else
    CCR_TOKEN_FILE="$(token_for "$repo")" GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0 \
      git -C "$mirror" remote update --prune >/dev/null 2>&1 \
      || die "fetch failed (does the token still cover $repo?)"
  fi
  # The mirror is read by $APP_USER's git; owned by root so its config is root's.
  chmod -R a+rX "$mirror"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  clone)
    repo="${1:-}"; name="${2:-}"
    valid_repo "$repo" || die "repository must be owner/name"
    repo="${repo%.git}"
    [[ -n $name ]] || name="${repo##*/}"
    valid_name "$name" || die "destination must be a plain folder name"
    target="$PROJECTS/$name"
    [[ -e $target ]] && die "$name already exists -- use 'pull' to update it"
    sync_mirror "$repo" "$name"
    as_user git clone --quiet "$MIRRORS/$name.git" "$target" || die "clone from mirror failed"
    # origin points at GitHub like a normal clone; pushes need the user's own auth.
    as_user git -C "$target" remote set-url origin "https://github.com/$repo.git"
    echo "cloned $repo into $target"
    ;;
  pull)
    name="${1:-}"
    valid_name "$name" || die "folder must be a plain name under projects/"
    target="$PROJECTS/$name"
    [[ -d $target/.git ]] || die "$name is not a git repository"
    # Read the origin as the user too: .git/config is user-controlled input.
    url="$(as_user git -C "$target" remote get-url origin)"
    [[ $url =~ ^https://github\.com/([A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*)(\.git)?$ ]] \
      || die "origin is not a plain github.com https remote"
    repo="${BASH_REMATCH[1]}"
    sync_mirror "$repo" "$name"
    branch="$(as_user git -C "$target" symbolic-ref --short HEAD 2>/dev/null)" \
      || die "$name has no branch checked out"
    as_user git -C "$target" pull --quiet --ff-only "$MIRRORS/$name.git" "$branch" \
      || die "pull failed (local changes, or a diverged branch?)"
    echo "pulled $name ($branch)"
    ;;
  list)
    # Every configured token, so the list spans all the owners you set up.
    # Counted before the pipeline: a variable set inside `{ ...; } | sort`
    # lives in a subshell and would read as 0 out here.
    found=0
    for tf in "$TOKEN_DIR"/*.token "$TOKEN_FILE"; do [[ -r $tf ]] && found=1; done
    [[ $found -eq 1 ]] || die "no GitHub token configured on this server"
    # The token goes to curl as a config file on stdin (-K -), not as a -H
    # argument: argv is world-readable in /proc, a pipe is not.
    gh_get() {
      printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/vnd.github+json"\nurl = "%s"\n' \
        "$(cat "$1")" "$2" | curl -sf -K - 2>/dev/null \
        | grep -o '"full_name"[[:space:]]*:[[:space:]]*"[^"]*"' | cut -d'"' -f4
    }
    { for tf in "$TOKEN_DIR"/*.token "$TOKEN_FILE"; do
      [[ -r $tf ]] || continue
      gh_get "$tf" "https://api.github.com/user/repos?per_page=100&sort=updated&affiliation=owner,collaborator,organization_member"
      gh_get "$tf" "https://api.github.com/installation/repositories?per_page=100"
    done; } | sort -u
    ;;
  *)
    die "usage: sudo ccr-git {clone <owner/repo> [folder] | pull <folder> | list}"
    ;;
esac
